# Секреты и сессии — никогда не коммитим
.env
*.session
*.session-journal
data/vk_user_token.txt
data/vk_app_secret.txt
data/vk_session.json
data/.vk_refresh.lock

# Сырой список прокси (локально, не в репо)
data/proxies_raw.txt

# Архивы Telegram-разведки
data/telegram_harvest/raw/
data/telegram_harvest/filtered/
data/telegram_harvest/.seen.json

# Архивы VK-разведки
data/vk_harvest/raw/
data/vk_harvest/filtered/
data/vk_harvest/.seen.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Кастомные скиллы — НЕ игнорируем (это пользовательские данные, не секреты)
# Но runtime-артефакты скиллов игнорируем
.claude/skills/*/runtime/
.claude/skills/*/logs/

# Playwright MCP — runtime-кеш (console-*.log, page-*.yml), пересоздаётся автоматически
.playwright-mcp/

# Claude Code — локальные настройки и диагностика (НЕ часть проекта)
# settings.local.json палит абсолютные пути пользователя,
# fix_vk_bom.py / find_ppl_smoke_test.py — одноразовые диагностические скрипты
.claude/

# Методологические исходники (Курпатов) — НЕ в репо, держим локально
Главные\ вопросы\ жизни.\ Универсальные\ правила.md
Индивидуальные\ отношения.\ Теория\ и\ практика\ эмпатии.md
Развитие\ личности.\ Психология\ и\ психотерапия.md

# Шорт-лист кандидатов — PII, удалён из истории 2026-06-10 (filter-repo).
# Любые похожие файлы с шаблоном candidates-shortlist.md — тоже в игноре,
# чтобы случайно не закоммитить.
*-candidates-shortlist.md
candidates-shortlist.md

# Obsidian случайно открыл filtered/ как vault — не коммитим служебную мета
data/telegram_harvest/filtered/.obsidian/
data/vk_harvest/filtered/.obsidian/
